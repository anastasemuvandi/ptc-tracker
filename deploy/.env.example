# Copy to .env (never commit .env). Generate secrets with:
#   ./scripts/generate-secrets.sh >> .env

# Public URL users open (used in invitation/reset links and as token issuer).
# Serve over HTTPS in production: the refresh cookie is Secure.
PTC_PUBLIC_BASE_URL=https://ptc.example.gov.rw
PTC_HTTP_PORT=8088
# Set false ONLY for local http://localhost trials.
PTC_COOKIE_SECURE=true

# First platform administrator: invited at first start if none exists. With
# mail disabled the invitation link is written to the backend log.
PTC_BOOTSTRAP_ADMIN_EMAIL=

# Institution SMTP relay (email is the guaranteed reminder channel).
PTC_MAIL_ENABLED=false
PTC_MAIL_FROM=ptc-tracker@example.gov.rw
PTC_SMTP_HOST=
PTC_SMTP_PORT=25
PTC_SMTP_USER=
PTC_SMTP_PASSWORD=
PTC_SMTP_STARTTLS=false

# Web Push (VAPID). Leave empty to have keys generated into the key volume.
PTC_VAPID_PUBLIC_KEY=
PTC_VAPID_PRIVATE_KEY=
PTC_VAPID_SUBJECT=mailto:ptc-tracker@example.gov.rw

